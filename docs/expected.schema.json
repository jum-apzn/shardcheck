{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "shardcheck expected manifest v1",
  "required": [
    "schema_version",
    "shards"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "shards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f\\ud800-\\udfff]"
        }
      }
    }
  }
}
